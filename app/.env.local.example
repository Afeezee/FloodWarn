# FloodWarn — environment variables
# Copy this file to .env.local (in the app/ directory) and fill in the
# values. .env.local is gitignored by default in Next.js.

# ---- Required ----

# Neon Postgres connection string. Must include ?sslmode=require so
# postgres.js negotiates TLS. Provision at https://neon.tech, create a
# database (any name), and paste the pooled connection string here.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.neon.tech/floodwarn?sslmode=require"

# ---- Optional ----

# Public-facing origin used to build absolute URLs in shared metadata
# (PWA manifest, Open Graph). Falls back to VERCEL_URL in production.
# NEXT_PUBLIC_SITE_URL="https://floodwarn.vercel.app"

# Set to "1" to enable extra request-timing logs in the API routes.
# DEBUG_TIMINGS="0"
